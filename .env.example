# Copy to .env and fill in what you have. Nothing here is read from a file by the library:
# these are the environment variables the CLI, the library and the MCP server all read.
# Never commit a filled-in copy.

# --- Decision model: pick one. Clef is the default when it is configured, then Jev, then a LiteLLM model.

# Clef on Cloudflare Workers AI. Reads the numbered screenshot and the page text.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# clef (27B, reads page text) or clef-flash (9B, cheaper, too weak to read page text).
MMJB_CLEF_MODEL=clef

# Jev on OpenRouter. Reads the element list and the page text, ignores the screenshot.
OPENROUTER_API_KEY=
# MMJB_JEV_MODEL=typesafe/jev-1.13

# Which decision model to use: clef, clef-flash, jev, llm, an installed plugin name, or
# package.module:ClassName. Leave it unset and it is chosen from the variables above.
# MMJB_DECIDER=llm

# A LiteLLM vision model that answers the same questions, so no Clef or Jev account is needed.
# Falls back to MMJB_FALLBACK_MODEL, then to openrouter/deepseek/deepseek-v4.1-flash.
# MMJB_DECIDER_MODEL=openrouter/deepseek/deepseek-v4.1-flash

# --- Fallback model: an ordinary vision LLM that takes one step when the decision model is unsure.
MMJB_FALLBACK_MODEL=openrouter/deepseek/deepseek-v4.1-flash
# LiteLLM reads the provider's own key from the usual variables:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# --- Browser
# Attach to a Chrome you started yourself instead of launching one. Chrome needs
# --remote-debugging-port=9222 for this to work.
# MMJB_CDP_URL=http://127.0.0.1:9222

# Use your installed Google Chrome rather than Playwright's own Chromium.
# MMJB_CHROME=1

# Show the browser window. Useful when you want to watch a run.
# MMJB_HEADFUL=1

# --- Extension points
# A safety policy: allow(action, element, goal) -> bool. It replaces the built-in rules.
# MMJB_POLICY=my_package.policies:my_allow

# A fallback model class: package.module:ClassName. It replaces LiteLLMFallback.
# MMJB_FALLBACK=my_package.fallbacks:MyFallback

# --- Logging
# ERROR, WARNING, INFO or DEBUG. Everything goes to stderr, never to stdout.
# MMJB_LOG_LEVEL=WARNING