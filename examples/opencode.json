{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mmjb": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/foklepoint/multi-modal-jev-browser",
        "mmjb-mcp"
      ],
      "enabled": true,
      "environment": {
        "CLOUDFLARE_API_TOKEN": "your_cloudflare_token",
        "CLOUDFLARE_ACCOUNT_ID": "your_account_id"
      }
    }
  }
}